# Local development only — used by docker-compose.yml, not production.
# syntax=docker/dockerfile:1
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
RUN npm ci

COPY backend backend
COPY scripts/docker-entrypoint.dev.sh scripts/docker-entrypoint.dev.sh
RUN chmod +x /app/scripts/docker-entrypoint.dev.sh

EXPOSE 3000

CMD ["npm", "run", "dev", "--workspace=backend"]
